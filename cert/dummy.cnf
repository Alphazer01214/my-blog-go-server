[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req
x509_extensions = v3_req

[dn]
C = CN
ST = Beijing
L = Beijing
O = MyBlog
OU = Dev
CN = localhost

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = frp-hat.com
DNS.3 = frp-bus.com
IP.1 = 127.0.0.1
IP.2 = ::1