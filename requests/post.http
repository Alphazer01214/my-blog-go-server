

@baseUrl = http://localhost:2333
@accessToken = your_access_token
@refreshToken = your_refresh_token

### create a public post
POST {{baseUrl}}/api/create
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "env": {
    "ipv6": "test",
    "device_info": "test",
    "os": "Windows"
  },
  "title": "test",
  "content": "test",
  "keywords": ["acceed", "coat", "114514"],
  "category": "test",
  "public": true,
  "cover": "https://cdn.discordapp.com/avatars/1/1.png"
}

### create a private post
POST {{baseUrl}}/api/create
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "env": {
    "ipv6": "test",
    "device_info": "test",
    "os": "Windows"
  },
  "title": "private test",
  "content": "private private private",
  "keywords": ["acceed", "coat", "114514"],
  "category": "test",
  "public": false,
  "cover": "https://cdn.discordapp.com/avatars/1/1.png"
}

### get one public post by id
GET {{baseUrl}}/api/post/1

### get one private post by id (must be author and logged in)
GET {{baseUrl}}/api/post/2
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

### get all posts
GET {{baseUrl}}/api/post

### get posts by pagination
GET {{baseUrl}}/api/post?page=1&page_size=10

### update post (canonical)
POST {{baseUrl}}/api/update
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "post_id": 1,
  "title": "updated title",
  "content": "updated content",
  "keywords": ["go", "api"],
  "category": "test",
  "public": true,
  "cover": "https://cdn.discordapp.com/avatars/1/1.png",
  "env": {
    "ipv6": "test",
    "device_info": "test",
    "os": "Windows"
  }
}

### update post (compat alias)
POST {{baseUrl}}/api/post/update
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "post_id": 1,
  "title": "updated title via alias",
  "content": "updated content via alias",
  "keywords": ["go", "api"],
  "category": "test",
  "public": true,
  "cover": "https://cdn.discordapp.com/avatars/1/1.png",
  "env": {
    "ipv6": "test",
    "device_info": "test",
    "os": "Windows"
  }
}

### delete post
DELETE {{baseUrl}}/api/post/1
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

### like a post (toggle)
POST {{baseUrl}}/api/post/like
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "post_id": 1
}

### dislike a post (toggle)
POST {{baseUrl}}/api/post/dislike
Content-Type: application/json
Cookie: access-token={{accessToken}}; refresh-token={{refreshToken}}

{
  "post_id": 1
}
